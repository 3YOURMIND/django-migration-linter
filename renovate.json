{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Group dev/test tooling updates",
      "matchDepTypes": ["dev", "optional"],
      "groupName": "dev dependencies"
    },
    {
      "description": "Monthly Django updates (install range)",
      "matchPackageNames": ["django"],
      "schedule": ["monthly"]
    }
  ]
}
